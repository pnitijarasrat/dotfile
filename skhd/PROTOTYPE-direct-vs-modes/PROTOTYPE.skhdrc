# PROTOTYPE (#112), throwaway: direct combos vs modes for window management.
# Both styles are live at once; use whichever your hands reach for and note why.
# Every press is logged to /tmp/PROTOTYPE-skhd-trial.log (./trial.sh log).

# ══ Style A: direct combos (one chord per action) ══
# Hyper = focus, ⌃⌥ = swap, ⌃⌘ = resize (all free per #109)
hyper - h : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct focus-west yabai -m window --focus west
hyper - j : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct focus-south yabai -m window --focus south
hyper - k : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct focus-north yabai -m window --focus north
hyper - l : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct focus-east yabai -m window --focus east

ctrl + alt - h : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct swap-west yabai -m window --swap west
ctrl + alt - j : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct swap-south yabai -m window --swap south
ctrl + alt - k : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct swap-north yabai -m window --swap north
ctrl + alt - l : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct swap-east yabai -m window --swap east

ctrl + cmd - h : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct resize-left yabai -m window --resize left:-40:0
ctrl + cmd - j : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct resize-down yabai -m window --resize bottom:0:40
ctrl + cmd - k : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct resize-up yabai -m window --resize top:0:-40
ctrl + cmd - l : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct resize-right yabai -m window --resize right:40:0

hyper - f : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct zoom yabai -m window --toggle zoom-fullscreen
hyper - t : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct float yabai -m window --toggle float --grid 4:4:1:1:2:2
hyper - e : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh direct balance yabai -m space --balance

# ══ Style B: window mode (Hyper+W in, Esc/Return/Hyper+W out) ══
# '@' captures the keyboard: unbound keys are swallowed while in the mode, so stray
# letters never reach the app. The window border turns navy while the mode is on.
# Known risk (#107): a Thai/English switch reloads skhd and drops back to default
# WITHOUT running the default-mode command, so the border can stay navy while keys
# type normally. If you see that, it bit you.
:: default : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode exit borders active_color=0xffc0c0c0
:: win @ : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode enter borders active_color=0xff000080

hyper - w ; win
win < escape ; default
win < return ; default
win < hyper - w ; default

# hjkl focus, shift+hjkl swap, ctrl+hjkl resize: all stay in the mode (repeatable)
win < h : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode focus-west yabai -m window --focus west
win < j : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode focus-south yabai -m window --focus south
win < k : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode focus-north yabai -m window --focus north
win < l : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode focus-east yabai -m window --focus east

win < shift - h : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode swap-west yabai -m window --swap west
win < shift - j : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode swap-south yabai -m window --swap south
win < shift - k : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode swap-north yabai -m window --swap north
win < shift - l : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode swap-east yabai -m window --swap east

win < ctrl - h : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode resize-left yabai -m window --resize left:-40:0
win < ctrl - j : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode resize-down yabai -m window --resize bottom:0:40
win < ctrl - k : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode resize-up yabai -m window --resize top:0:-40
win < ctrl - l : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode resize-right yabai -m window --resize right:40:0

# one-shot actions: do it, then leave the mode (skhd -k replays Esc to exit)
win < f : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode zoom yabai -m window --toggle zoom-fullscreen; skhd -k escape
win < t : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode float yabai -m window --toggle float --grid 4:4:1:1:2:2; skhd -k escape
win < e : $HOME/.config/skhd/PROTOTYPE-direct-vs-modes/run.sh mode balance yabai -m space --balance; skhd -k escape

# ══ Carried over unchanged from ~/.skhdrc so daily life keeps working ══
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 8 : yabai -m space --focus 4
cmd - 9 : yabai -m space --focus 5
cmd - 0 : yabai -m space --focus 6

shift + cmd - 1 : yabai -m window --space 1
shift + cmd - 2 : yabai -m window --space 2
shift + cmd - 3 : yabai -m window --space 3
shift + cmd - 7 : yabai -m window --space 4
shift + cmd - 8 : yabai -m window --space 5
shift + cmd - 9 : yabai -m window --space 6

shift + alt - r : yabai --restart-service
