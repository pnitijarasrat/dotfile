# skhd config. skhd finds it at ~/.config/skhd/skhdrc with no flags.
# skhd reloads it on save; it needs no chmod.
#
# Window Shortcuts follow the scheme in #113: the modifier picks the verb,
# hjkl = west/south/north/east. ctrl+cmd focuses, ctrl+alt swaps,
# ctrl+shift resizes. Hyper (Right Option, via Karabiner) only pairs with
# left-hand keys. Bare alt is left to the terminal (Meta) and dead keys.

# ── Focus window ──
ctrl + cmd - h : yabai -m window --focus west
ctrl + cmd - j : yabai -m window --focus south
ctrl + cmd - k : yabai -m window --focus north
ctrl + cmd - l : yabai -m window --focus east

# ── Swap window with the one in that direction ──
ctrl + alt - h : yabai -m window --swap west
ctrl + alt - j : yabai -m window --swap south
ctrl + alt - k : yabai -m window --swap north
ctrl + alt - l : yabai -m window --swap east

# ── Resize window (grow/shrink toward that edge) ──
ctrl + shift - h : yabai -m window --resize left:-40:0
ctrl + shift - j : yabai -m window --resize bottom:0:40
ctrl + shift - k : yabai -m window --resize top:0:-40
ctrl + shift - l : yabai -m window --resize right:40:0

# ── Layout ──
hyper - f : yabai -m window --toggle zoom-fullscreen            # maximize (zoom) current window
hyper - t : yabai -m window --toggle float --grid 4:4:1:1:2:2   # float + center
hyper - e : yabai -m space --balance                            # rebalance bsp split sizes

# ── Spaces: cmd+digit to switch, cmd+shift+digit to move a window along ──
# Kept as they were; another ticket replaces them.
cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 8 : yabai -m space --focus 4
cmd - 9 : yabai -m space --focus 5
cmd - 0 : yabai -m space --focus 6

shift + cmd - 1 : yabai -m window --space 1
shift + cmd - 2 : yabai -m window --space 2
shift + cmd - 3 : yabai -m window --space 3
shift + cmd - 7 : yabai -m window --space 4
shift + cmd - 8 : yabai -m window --space 5
shift + cmd - 9 : yabai -m window --space 6
