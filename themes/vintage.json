{
  "name": "Vintage",
  "work_description": "light, K-95-style: navy on white, Windows VGA ANSI",
  "shadows": false,
  "macos": { "appearance": "light", "accent": "graphite", "highlight": "blue" },
  "rules": { "opacity": 1, "blur": 0, "radius": 0, "icons": false },
