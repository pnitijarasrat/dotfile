#!/usr/bin/env sh

# yabai config. yabai finds it at ~/.config/yabai/yabairc with no flags.
# This file must be executable: chmod +x ~/.config/yabai/yabairc

# ── Scripting addition (optional, needs SIP partially disabled) ──
# Unlocks extras like real window borders and moving unmanaged windows.
# Leave commented out until you've disabled SIP for yabai — see:
# https://github.com/koekeishiya/yabai/wiki/Disabling-System-Integrity-Protection
#
# sudo yabai --load-sa
# yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# ── Layout ──
yabai -m config layout bsp
yabai -m config window_placement second_child

# ── Spacing ──
# Top and bottom padding are the bar's: the active Theme's SketchyBar layout
# sets them when it loads (#166).
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 8

# ── Mouse ──
yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier fn
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# ── Window behavior ──
yabai -m config window_zoom_persist on
yabai -m config window_shadow on
yabai -m config window_animation_duration 0.0
yabai -m config window_opacity off
yabai -m config split_ratio 0.5
yabai -m config auto_balance off

# ── Borders (requires the scripting addition above) ──
# yabai -m config window_border               on
# yabai -m config window_border_width         4
# yabai -m config active_window_border_color  0xff775759
# yabai -m config normal_window_border_color  0xff505050

# ── Apps that should float instead of being tiled ──
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^System Preferences$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^App Store$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off
yabai -m rule --add title="Preferences" manage=off

# A restarted yabai starts with no top or bottom padding, so have the bar's
# layout set them again. Harmless if SketchyBar isn't running yet.
sketchybar --reload 2>/dev/null

echo "yabai configuration loaded.."
