# GitHub CLI login (may contain an auth token)
gh/hosts.yml

# Claude Code per-machine permissions
**/.claude/settings.local.json

# Chrome writes this into an unpacked theme folder when it loads it
chrome/vintage-theme/Cached Theme.pak

# Spicetify writes these when it backs up and patches Spotify
spicetify/Backup/
spicetify/Extracted/
spicetify/CustomApps/
spicetify/Extensions/

# Claude Code writes the mod API's types beside a mod each time it loads it
claude/*/.claude-plugin/types/
