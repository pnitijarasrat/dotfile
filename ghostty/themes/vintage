# Vintage theme: Work surface (light, K-95-style: navy on white, Windows VGA ANSI)
# Roles and values from docs/theme-spec.md
# Ghostty has no trailing comments, so each role name is on the line above its value
# work_bg
background = #FFFFFF
# work_fg
foreground = #000080

# work_cursor
cursor-color = #000000
# work_cursor_text
cursor-text = #FFFFFF
# work_selection
selection-background = #000080
# work_selection_text
selection-foreground = #FFFFFF

# Normal colors (0-7)
# ansi_0
palette = 0=#000000
# ansi_1
palette = 1=#800000
# ansi_2
palette = 2=#008000
# ansi_3
palette = 3=#808000
# ansi_4
palette = 4=#000080
# ansi_5
palette = 5=#800080
# ansi_6
palette = 6=#008080
# ansi_7
palette = 7=#C0C0C0

# Bright colors (8-15)
# ansi_8
palette = 8=#808080
# ansi_9
palette = 9=#FF0000
# ansi_10
palette = 10=#00FF00
# ansi_11
palette = 11=#FFFF00
# ansi_12
palette = 12=#0000FF
# ansi_13
palette = 13=#FF00FF
# ansi_14
palette = 14=#00FFFF
# ansi_15
palette = 15=#FFFFFF
