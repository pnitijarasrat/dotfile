# Vintage theme: Work surface (soft IBM 5153 on black)
# Roles and values from docs/theme-spec.md
# Ghostty has no trailing comments, so each role name is on the line above its value
# work_bg
background = #000000
# work_fg
foreground = #C4C4C4

# work_cursor
cursor-color = #4EDC4E
# work_cursor_text
cursor-text = #000000
# work_selection
selection-background = #000080
# work_selection_text
selection-foreground = #FFFFFF

# Normal colors (0-7)
# ansi_0
palette = 0=#000000
# ansi_1
palette = 1=#C40000
# ansi_2
palette = 2=#00C400
# ansi_3
palette = 3=#C47E00
# ansi_4
palette = 4=#0000C4
# ansi_5
palette = 5=#C400C4
# ansi_6
palette = 6=#00C4C4
# ansi_7
palette = 7=#C4C4C4

# Bright colors (8-15)
# ansi_8
palette = 8=#4E4E4E
# ansi_9
palette = 9=#DC4E4E
# ansi_10
palette = 10=#4EDC4E
# ansi_11
palette = 11=#F3F34E
# ansi_12
palette = 12=#4E4EDC
# ansi_13
palette = 13=#F34EF3
# ansi_14
palette = 14=#4EF3F3
# ansi_15
palette = 15=#FFFFFF
