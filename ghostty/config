# ~/.config/ghostty/config

title="terminal"
window-padding-x=8
window-padding-y=8
cursor-style=block
cursor-style-blink=false
shell-integration-features = no-cursor

# Vintage theme: Work surface (docs/theme-spec.md)
theme=vintage
# A Switch (`theme <name>`, themes/theme.mjs) writes the active Theme here; Ghostty loads it
# after this file, so it overrides the line above. Absent until the first Switch.
config-file=?active-theme
# work_grid
split-divider-color=#C0C0C0

# The window's shape (opacity, blur, corners and title bar) comes from the Theme's
# Ghostty theme, ghostty/themes/<name>, generated from its Theme rules: setting it
# here would win over every Theme. Vintage's square corners lose visible tabs;
# splits stay.

# JetBrains Mono NL, falling back to Menlo, then Thonburi
font-family="JetBrains Mono NL"
font-family="Menlo"
font-family="Thonburi"
font-size=14
window-inherit-font-size=false
font-synthetic-style=false
# Regular only: bold and italic text use the Regular face
font-style-bold=false
font-style-italic=false
font-style-bold-italic=false
font-feature=-calt, -liga
