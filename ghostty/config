# ~/.config/ghostty/config

title="terminal"
window-padding-x=8
window-padding-y=8
cursor-style=block
cursor-style-blink=false
shell-integration-features = no-cursor

# Vintage theme: Work surface (docs/theme-spec.md)
theme=vintage
# work_grid
split-divider-color=#C0C0C0

# Purist fidelity: opaque, no blur, square corners (visible tabs are lost, splits stay)
background-opacity=1
background-blur=false
window-decoration=none

# Fixedsys Excelsior, falling back to Menlo, then Thonburi
font-family="Fixedsys Excelsior"
font-family="Menlo"
font-family="Thonburi"
font-size=32
window-inherit-font-size=false
font-synthetic-style=false
font-feature=-calt, -liga
