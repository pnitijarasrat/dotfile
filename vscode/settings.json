{
    "claudeCode.preferredLocation": "panel",
    // Local extension in vscode/vintage-theme (#19).
    "workbench.colorTheme": "Vintage",
    // Frame (#20): VSCode draws the title bar, so the theme can make it navy,
    // and the context menus, so they are Frame grey instead of native macOS.
    "window.titleBarStyle": "custom",
    "window.menuStyle": "custom",
    // The experimental modern UI floats the parts as rounded cards and ignores
    // tab.activeBackground; the classic layout keeps the Frame flush and square.
    "workbench.experimental.modernUI": false,
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.gpuAcceleration": "off",
    "explorer.confirmDragAndDrop": false,
    "editor.formatOnSave": true,
    "git.confirmSync": false,
    "totalTypeScript.hideAllTips": false,
    "totalTypeScript.hideBasicTips": false,

    // Work surface font (docs/theme-spec.md, #79). Zoom 1 scales everything by
    // 1.2, so code at 11 renders at about 13 and the chrome keeps its size.
    "editor.fontFamily": "'JetBrains Mono NL', Menlo, Thonburi",
    "editor.fontSize": 11,
    // 0 is automatic: VSCode picks a line height from the font size.
    "editor.lineHeight": 0,
    "editor.fontWeight": "normal",
    "editor.fontLigatures": false,
    "window.zoomLevel": 1,
    // The terminal (and the Claude Code panel in it) is Work surface too:
    // same font as the editor. Its lineHeight multiplies the font's cell height.
    "terminal.integrated.fontFamily": "'JetBrains Mono NL', Menlo, Thonburi",
    "terminal.integrated.fontSize": 11,
    "terminal.integrated.lineHeight": 1,
    "terminal.integrated.fontWeight": "normal",
    // JetBrains Mono NL has a real bold face; bold looks the same as normal (ADR 0003).
    "terminal.integrated.fontWeightBold": "normal",
    "terminal.integrated.fontLigatures.enabled": false
}
