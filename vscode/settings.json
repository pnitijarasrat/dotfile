{
    "claudeCode.preferredLocation": "panel",
    // Local extension in vscode/vintage-theme (#19).
    "workbench.colorTheme": "Vintage",
    // Frame (#20): VSCode draws the title bar, so the theme can make it navy,
    // and the context menus, so they are Frame grey instead of native macOS.
    "window.titleBarStyle": "custom",
    "window.menuStyle": "custom",
    // The experimental modern UI floats the parts as rounded cards and ignores
    // tab.activeBackground; the classic layout keeps the Frame flush and square.
    "workbench.experimental.modernUI": false,
    "terminal.integrated.mouseWheelScrollSensitivity": 3,
    "terminal.integrated.gpuAcceleration": "off",
    // Show the theme's IBM 5153 ANSI colors as-is; the default ratio (4.5)
    // lightens the dark ones (ansi_1, ansi_4, ansi_8) on work_bg.
    "terminal.integrated.minimumContrastRatio": 1,
    "explorer.confirmDragAndDrop": false,
    "editor.formatOnSave": true,
    "git.confirmSync": false,
    "totalTypeScript.hideAllTips": false,
    "totalTypeScript.hideBasicTips": false,

    // Work surface font (docs/theme-spec.md). Fixedsys Excelsior is only crisp
    // when fontSize x 1.2^zoomLevel is a multiple of 8. Zoom 1 brings the
    // chrome (13) to ~15.6 and 13.333 brings code to 16, so all panes match (#34).
    "editor.fontFamily": "'Fixedsys Excelsior', Menlo, Thonburi",
    "editor.fontSize": 13.333,
    "editor.lineHeight": 13.333,
    "editor.fontWeight": "normal",
    "editor.fontLigatures": false,
    "window.zoomLevel": 1,
    // The terminal (and the Claude Code panel in it) is Work surface too (#33):
    // same font as the editor. Its lineHeight multiplies the font's cell height,
    // which for Fixedsys Excelsior is exactly 1 em.
    "terminal.integrated.fontFamily": "'Fixedsys Excelsior', Menlo, Thonburi",
    "terminal.integrated.fontSize": 13.333,
    "terminal.integrated.lineHeight": 1,
    "terminal.integrated.fontWeight": "normal",
    "terminal.integrated.fontLigatures.enabled": false
}
