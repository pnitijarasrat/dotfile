PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/color.sh"

# The bar's layout is per-Theme (ADR 0011): the active Theme's layouts/<theme>.sh,
# or the Vintage theme's taskbar if it has none. The active Theme is the one
# color.sh loaded, so it's Vintage when a Theme's palette was never generated.
layout="$CONFIG_DIR/layouts/$active_theme.sh"
[ -f "$layout" ] || layout="$CONFIG_DIR/layouts/vintage.sh"
source "$layout"

sketchybar --update
